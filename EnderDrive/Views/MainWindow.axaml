<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EnderDrive.ViewModels"
        x:Class="EnderDrive.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EnderDrive"
        Width="1200" Height="760" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True">

    <Grid RowDefinitions="40,*" ColumnDefinitions="256,*">

        <!-- ===== BARRA SUPERIOR ===== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="{StaticResource SurfaceLowestBrush}"
                PointerPressed="TitleBar_PointerPressed">
            <!-- Margen derecho de 140px: ahí van los botones nativos de Windows -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,140,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4"
                            Background="{StaticResource SurfaceBrush}">
                        <TextBlock Classes="icon" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}" Text="deployed_code"/>
                    </Border>
                    <TextBlock Classes="title-sm" VerticalAlignment="Center"
                               Foreground="{StaticResource OnSurfaceBrush}" Text="EnderDrive"/>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="2" Padding="4,1">
                        <TextBlock Classes="label-mono-sm"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" Text="v0.1"/>
                    </Border>
                </StackPanel>

                <!-- Usuario (Fase 3: datos reales) -->
                <Border Grid.Column="2" Width="28" Height="28" CornerRadius="14"
                        Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                    <TextBlock Classes="icon" HorizontalAlignment="Center"
                               Foreground="{StaticResource OnPrimaryBrush}" Text="person"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== MENÚ LATERAL ===== -->
        <Border Grid.Row="1" Grid.Column="0" Padding="12"
                Background="{StaticResource SurfaceLowBrush}">
            <DockPanel>
                <!-- Tarjeta de capacidad (abajo) -->
                <Border DockPanel.Dock="Bottom" Padding="8"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label-mono-sm"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text="Capacidad Drive"/>
                            <TextBlock Grid.Column="1" Classes="label-mono-sm"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="{Binding StorageText}"/>
                        </Grid>
                        <ProgressBar Value="{Binding StoragePercent}" Maximum="100" Height="8"
                                     Background="{StaticResource SurfaceLowestBrush}"
                                     Foreground="{StaticResource PrimaryContainerBrush}"/>
                        <TextBlock Classes="body-sm"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Text="{Binding SyncedWorldsText}"/>
                    </StackPanel>
                </Border>

                <!-- Navegación (arriba) -->
                <StackPanel Spacing="12">
                    <TextBlock Classes="label-mono-sm" Margin="8,4"
                               Foreground="{StaticResource OutlineBrush}"
                               Text="ALMACÉN DE BLOQUES"/>
                    <ListBox Classes="nav"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="{Binding Icon}"/>
                                    <TextBlock Classes="title-sm" VerticalAlignment="Center"
                                               Text="{Binding Label}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO (página actual) ===== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Margin="20"
                        Content="{Binding CurrentPage}"/>
    </Grid>
</Window>