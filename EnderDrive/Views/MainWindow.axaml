<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EnderDrive.ViewModels"
        x:Class="EnderDrive.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EnderDrive"
        Width="1200" Height="760" MinWidth="1000" MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

    <Grid RowDefinitions="40,*" ColumnDefinitions="256,*">
        <!-- ===== Barra superior ===== -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="{StaticResource SurfaceLowestBrush}"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,140,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Icono -->
                    <Border Width="20" Height="20" CornerRadius="4"
                            Background="{StaticResource SurfaceBrush}">
                        <TextBlock Classes="icon" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="deployed_code"/>
                    </Border>

                    <!-- Nombre -->
                    <TextBlock Classes="title-sm" VerticalAlignment="Center"
                               Foreground="{StaticResource OnSurfaceBrush}"
                               Text="EnderDrive"/>

                    <!-- Version -->
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="2" Padding="4,1">
                         <TextBlock Classes="label-mono-sm" VerticalAlignment="Center"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="v0.1"/>
                    </Border>

                </StackPanel>
                
                <!-- Usuario -->
                <Border Grid.Column="2" Width="28" Height="28" CornerRadius="14"
                        Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                    <TextBlock Classes="icon" HorizontalAlignment="Center"
                               Foreground="{StaticResource OnPrimaryBrush}"
                               Text="person"/>
                </Border>
                
            </Grid>
        </Border>

        <!-- ===== Menu lateral =====-->
        <Border Grid.Row="1" Grid.Column="0" Padding="12"
                Background="{StaticResource SurfaceLowBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Padding="8"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel Spacing="8">
                        <!-- Fila titulo a la izquierda, valor a la derecha -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="label-mono-sm" 
                                       Foreground="{StaticResource OnSurfaceVariantBrush}"
                                       Text= "Capacidad Drive"/>
                            <TextBlock Grid.Column="1" Classes="label-mono-sm" 
                                       Foreground="{StaticResource PrimaryBrush}" 
                                       Text="{Binding StorageText}"/>
                        </Grid>

                        <!-- Barra -->
                        <ProgressBar Value="{Binding StoragePercent}" Maximum="100" Height="8"
                                     Background="{StaticResource SurfaceLowestBrush}"
                                     Foreground="{StaticResource PrimaryContainerBrush}"/>
                   
                        <!-- Texto inferior -->
                        <TextBlock Classes="body-sm"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   Text="{Binding SyncedWorldsText}"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="12">
                    <TextBlock Classes="label-mono-sm" Margin="8,4"
                                Foreground="{StaticResource OutlineBrush}"
                                 Text="ALMACÉN DE BLOQUES"/>
                    <ListBox Classes="nav"
                             ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="{Binding Icon}"/>
                                    <TextBlock Classes="title-sm" VerticalAlignment="Center"
                                               Text="{Binding Label}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- ===== CONTENIDO (página actual) ===== -->
        <ContentControl Grid.Row="1" Grid.Column="1" Margin="20"
                        Content="{Binding CurrentPage}"/>

        <!-- ===== AVISO FLOTANTE (copias, restauraciones…) =====
             Está en la ventana y no en una página para que siga visible al cambiar de página -->
        <Border Grid.Row="1" Grid.Column="1" Width="360" Margin="0,0,28,84" Padding="10"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                IsVisible="{Binding Toast.IsOpen}"
                Background="#F22A2A2C" CornerRadius="{StaticResource RadiusXl}"
                BoxShadow="0 16 36 0 #B3000000">
            <StackPanel Spacing="6">
                <!-- Cabecera: icono, título y cerrar -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="22" Height="22" CornerRadius="{StaticResource RadiusLg}"
                            Background="{StaticResource PrimarySoftBrush}">
                        <!-- El color lo ponen los estilos .toast-icon / .error (un Foreground aquí los anularía) -->
                        <TextBlock Classes="icon toast-icon" FontSize="14" HorizontalAlignment="Center"
                                   Classes.spin="{Binding Toast.IsRunning}"
                                   Classes.error="{Binding Toast.IsError}"
                                   Text="{Binding Toast.Icon}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Classes="title-sm" Margin="8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Toast.Title}"/>
                    <Button Grid.Column="2" Classes="inline" Width="20" Height="20"
                            Command="{Binding Toast.CloseCommand}" ToolTip.Tip="Cerrar">
                        <TextBlock Classes="icon" FontSize="14" Text="close"/>
                    </Button>
                </Grid>

                <TextBlock Classes="body-sm" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Toast.Subject}"/>

                <ProgressBar Classes="xp" Maximum="100" Value="{Binding Toast.Progress}"
                             Foreground="{StaticResource PrimaryContainerBrush}"
                             IsVisible="{Binding !Toast.IsError}"/>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="label-mono-sm toast-stage" TextWrapping="Wrap"
                               Classes.error="{Binding Toast.IsError}"
                               Text="{Binding Toast.StageText}"/>
                    <TextBlock Grid.Column="1" Classes="label-mono-sm" Margin="8,0,0,0"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="{Binding Toast.ProgressText}"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>