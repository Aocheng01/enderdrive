<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EnderDrive.ViewModels.Pages"
             x:Class="EnderDrive.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel>

        <!-- ===== BARRA SUPERIOR ===== -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="8"
                Background="{StaticResource SurfaceLowBrush}"
                CornerRadius="{StaticResource RadiusXl}"
                BoxShadow="0 1 2 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="32" Height="32" VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="{StaticResource RadiusLg}">
                    <TextBlock Classes="icon" HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}" Text="tune"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="label-mono-sm" Foreground="{StaticResource OutlineBrush}"
                               Text="EnderDrive  /  Preferencias"/>
                    <TextBlock Classes="headline-md" Foreground="{StaticResource OnSurfaceBrush}"
                               Text="{Binding Title}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="12">

                <!-- ===== SECCIÓN: SINCRONIZACIÓN AUTOMÁTICA ===== -->
                <Border Padding="16" Background="{StaticResource SurfaceLowBrush}"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Foreground="{StaticResource PrimaryBrush}" Text="cloud_sync"/>
                            <TextBlock Classes="title-lg" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}" Text="Sincronización automática"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title-sm" Foreground="{StaticResource OnSurfaceBrush}"
                                           Text="Subir los cambios al salir de un mundo"/>
                                <TextBlock Classes="body-sm" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Text="Cuando sales de un mundo en Minecraft, EnderDrive sube sus cambios a Google Drive. Solo para mundos que ya están en la nube."/>
                            </StackPanel>
                            <!-- OnContent/OffContent vacíos: sin el texto "On/Off" de Fluent -->
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding AutoUploadOnWorldClose}"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource OutlineVariantBrush}" Opacity="0.5"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title-sm" Foreground="{StaticResource OnSurfaceBrush}"
                                           Text="Avisar de novedades al abrir EnderDrive"/>
                                <TextBlock Classes="body-sm" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Text="Si hay mundos con una versión más nueva en la nube, mundos que no están en este PC o conflictos."/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          IsChecked="{Binding NotifyCloudChangesOnStartup}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== SECCIÓN: COPIAS DE SEGURIDAD ===== -->
                <Border Padding="16" Background="{StaticResource SurfaceLowBrush}"
                        CornerRadius="{StaticResource RadiusXl}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Foreground="{StaticResource PrimaryBrush}" Text="archive"/>
                            <TextBlock Classes="title-lg" VerticalAlignment="Center"
                                       Foreground="{StaticResource OnSurfaceBrush}" Text="Copias de seguridad"/>
                        </StackPanel>

                        <!-- Fila: carpeta de copias -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title-sm" Foreground="{StaticResource OnSurfaceBrush}"
                                           Text="Carpeta de copias"/>
                                <TextBlock Classes="body-sm" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Text="Dónde se guardan los .zip. Al cambiarla, las copias existentes no se mueven."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Classes="secondary" Command="{Binding ChooseBackupsFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="icon" FontSize="16" Text="drive_folder_upload"/>
                                        <TextBlock VerticalAlignment="Center" Text="Cambiar"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="toolbar" Command="{Binding ResetBackupsFolderCommand}"
                                        IsVisible="{Binding IsCustomBackupsPath}"
                                        ToolTip.Tip="Volver a la carpeta por defecto">
                                    <TextBlock Classes="icon" FontSize="16" Text="restart_alt"/>
                                </Button>
                                <Button Classes="toolbar" Command="{Binding OpenBackupsFolderCommand}"
                                        ToolTip.Tip="Abrir en el Explorador">
                                    <TextBlock Classes="icon" FontSize="16" Text="folder_open"/>
                                </Button>
                            </StackPanel>

                            <!-- Ruta completa en una caja "hundida" -->
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="12,8"
                                    Background="{StaticResource SurfaceLowestBrush}"
                                    CornerRadius="{StaticResource RadiusLg}">
                                <!-- Grid y no StackPanel: así el texto tiene ancho máximo y se recorta con "…" -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="icon" FontSize="16"
                                               Foreground="{StaticResource OutlineBrush}" Text="folder"/>
                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Classes="label-mono-md"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                                               ToolTip.Tip="{Binding BackupsPath}"
                                               Text="{Binding BackupsPath}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Height="1" Background="{StaticResource OutlineVariantBrush}" Opacity="0.5"/>

                        <!-- Fila: copias por mundo -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="title-sm" Foreground="{StaticResource OnSurfaceBrush}"
                                           Text="Copias que se guardan por mundo"/>
                                <TextBlock Classes="body-sm" TextWrapping="Wrap"
                                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                                           Text="Al crear una copia nueva, se borran las más antiguas que pasen de este número."/>
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Width="130" VerticalAlignment="Center"
                                           Minimum="1" Maximum="100" Increment="1" FormatString="0"
                                           Value="{Binding MaxBackupsPerWorld}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
