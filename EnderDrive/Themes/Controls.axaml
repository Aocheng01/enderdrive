<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Base común de botones ===== -->
  <Style Selector="Button">
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <!-- Efecto "hundido" al pulsar -->
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="translate(0px, 1px)"/>
  </Style>

  <!-- ===== Primario (verde, "Jugar") ===== -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
  </Style>

  <!-- ===== Secundario (gris oscuro) ===== -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{StaticResource SurfaceHighestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#39393B"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
  </Style>

  <!-- ===== Aviso (ámbar, "Subir cambios") ===== -->
  <Style Selector="Button.warning">
    <Setter Property="Background" Value="{StaticResource SecondaryContainerBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSecondaryFixedBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,0"/>
  </Style>
  <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSecondaryFixedBrush}"/>
  </Style>

  <!-- ===== Botón cuadrado solo-icono (⋮, refrescar…) ===== -->
  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>

  <!-- ===== Decoraciones de ventana de Avalonia 12 =====
       Con ExtendClientAreaToDecorationsHint, Avalonia dibuja encima de la ventana una capa con
       el título y los botones (pantalla completa, minimizar, maximizar, cerrar).
       Nosotros ya pintamos el título en nuestra barra, así que ocultamos el suyo
       y el botón de pantalla completa, que no usamos. -->
  <!-- El panel ya tiene IsVisible fijado por Avalonia (y eso gana a un estilo),
       así que ocultamos el texto que hay dentro -->
  <Style Selector="Panel#PART_TitleTextPanel > TextBlock">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- ===== Botones extra del diseño de Mis Mundos ===== -->
  <!-- Verde intenso con brillo ("Sincronizar ahora", "Restaurar esta copia").
       Ojo: no se puede llamar "accent", Fluent ya tiene una clase con ese nombre y la pinta de azul -->
  <Style Selector="Button.emerald">
    <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainerBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
  <!-- Button no tiene BoxShadow: el brillo se pone en el ContentPresenter de su plantilla -->
  <Style Selector="Button.emerald /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 14 0 #5910B981"/>
  </Style>
  <Style Selector="Button.emerald:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2ECC94"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainerBrush}"/>
  </Style>
  <Style Selector="Button.emerald:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainerBrush}"/>
  </Style>
  <!-- Discreto ("Abrir en el Explorador") -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="#992A2A2C"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
  </Style>
  <!-- Botón de barra de herramientas: icono cuadrado sobre SurfaceBrush -->
  <Style Selector="Button.toolbar">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <!-- Botón diminuto sin fondo (copiar semilla) -->
  <Style Selector="Button.inline">
    <Setter Property="Height" Value="16"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="Button.inline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Button.inline:pressed">
    <Setter Property="RenderTransform" Value="none"/>
  </Style>

  <!-- Rojo para acciones destructivas ("Eliminar") -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource ErrorContainerBrush}"/>
    <Setter Property="Foreground" Value="#FFDAD6"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B3261E"/>
    <Setter Property="Foreground" Value="#FFDAD6"/>
  </Style>

  <!-- Icono que gira (operación en curso) -->
  <Style Selector="TextBlock.spin">
    <Setter Property="RenderTransform" Value="rotate(0deg)"/>
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Colores del aviso flotante: verde normalmente, rojo si hubo un error -->
  <Style Selector="TextBlock.toast-icon">
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.toast-stage">
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="TextBlock.toast-icon.error, TextBlock.toast-stage.error">
    <Setter Property="Foreground" Value="{StaticResource TertiaryBrush}"/>
  </Style>

  <!-- Botones desactivados (funciones de fases futuras): mismo color, más apagados.
       Fluent pinta el fondo gris en el ContentPresenter, así que lo dejamos transparente
       para que se vea el Background del propio botón. -->
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.6"/>
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
  </Style>
  <Style Selector="Button.emerald:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnPrimaryContainerBrush}"/>
  </Style>
  <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#992A2A2C"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
  </Style>

  <!-- ===== Buscador (TextBox con clase "search") ===== -->
  <Style Selector="TextBox.search">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="4,0,12,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceLowestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource SurfaceLowestBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource SurfaceLowestBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBox.search:pointerover, TextBox.search:focus">
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
  </Style>

  <!-- ===== Desplegables de la barra (ComboBox con clase "toolbar") ===== -->
  <Style Selector="ComboBox.toolbar">
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,0,4,0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ComboBox.toolbar:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
  </Style>

  <!-- ===== Lista de mundos (ListBox con clase "world-list") ===== -->
  <!-- El ListBoxItem no pinta nada: todo el aspecto lo pone la tarjeta (Border.world-card) -->
  <Style Selector="ListBox.world-list">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.world-list ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ===== Tarjeta de mundo ===== -->
  <Style Selector="Border.world-card">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BoxShadow" Value="0 1 2 0 #40000000"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover Border.world-card">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
  </Style>
  <!-- Seleccionada: degradado, borde verde suave y sombra más marcada -->
  <Style Selector="ListBoxItem:selected Border.world-card">
    <Setter Property="Background" Value="{StaticResource SelectedCardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryRingBrush}"/>
    <Setter Property="BoxShadow" Value="0 4 6 0 #66000000"/>
  </Style>
  <!-- Franja verde a la izquierda: solo en la tarjeta seleccionada -->
  <Style Selector="Border.world-stripe">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="ListBoxItem:selected Border.world-stripe">
    <Setter Property="IsVisible" Value="True"/>
  </Style>

  <!-- ===== Etiqueta pequeña (loader, modo de juego…) ===== -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource SurfaceLowestBrush}"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Padding" Value="6,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
  </Style>
  <!-- Colores según el tipo de mundo -->
  <Style Selector="Border.chip.hardcore > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TertiaryBrush}"/>
  </Style>
  <Style Selector="Border.chip.modded > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style Selector="Border.chip.plugin > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryFixedBrush}"/>
  </Style>

  <!-- ===== Insignia redondeada de estado ("Solo en local") ===== -->
  <Style Selector="Border.status-badge">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- ===== Punto verde que "late" (estado activo) ===== -->
  <Style Selector="Ellipse.pulse">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1"/>
        </KeyFrame>
        <KeyFrame Cue="50%">
          <Setter Property="Opacity" Value="0.35"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== Barra de experiencia (ProgressBar con clase "xp") ===== -->
  <Style Selector="ProgressBar.xp">
    <Setter Property="Height" Value="8"/>
    <Setter Property="MinHeight" Value="8"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{StaticResource SurfaceLowestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>

  <!-- ===== Menú lateral (ListBox con clase "nav") ===== -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SurfaceHighestBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
  </Style>
</Styles>